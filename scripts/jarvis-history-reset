#!/usr/bin/python3 -I
"""jarvis-history-reset - the history lasts one day: kept through restarts and power-offs, emptied when a new day starts.

Install as /usr/local/bin/jarvis-history-reset (owner root, mode 755); run as the app user by
jarvis-history-reset.service (at boot, before the app and the monitor) and jarvis-history-reset.timer (every 10 minutes,
so midnight is caught while the Pi runs, and a clock that was wrong at boot - no RTC battery - is caught once it is set).

  --check   empty the history if it was last emptied before today (local time); otherwise do nothing
  --now     empty it right away (same as Settings > Clear History Now in the app)

"History" = speed tests, monitor samples and outages (netmon.db) and the tool log (history.log). On a new day the saved
Wi-Fi of visited sites is forgotten too (`wifi-clear`: keeps your own networks and the one in use right now).
Settings, saved devices, companies/locations, AP names, the vendor cache and the agent access log are kept.
"""
import datetime
import json
import os
import sqlite3
import subprocess
import sys
import time

DB_PATH = "/var/lib/jarvis-nettools/netmon.db"
HISTORY = "/opt/jarvis-nettools/history.log"
SINCE = "/var/lib/jarvis-nettools/history-since.json"       # when (and why) the history was last emptied
OLD_MARKER = "/var/lib/jarvis-nettools/keep-history-once"   # from the earlier power-on rule; removed when seen
TABLES = ("speed", "samples", "events")


def log(msg):
    print(msg, flush=True)


def wipe(reason, db_path=None, history=None, since=None, now=time.time):
    """Empty the history tables and the tool log; record when. Returns what was removed (rows per table)."""
    db_path, history, since = db_path or DB_PATH, history or HISTORY, since or SINCE
    removed = {}
    if os.path.exists(db_path):
        c = sqlite3.connect(db_path, timeout=30)
        try:
            have = {r[0] for r in c.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            with c:
                for t in TABLES:
                    if t in have:
                        removed[t] = c.execute(f"DELETE FROM {t}").rowcount
            c.execute("VACUUM")           # really gone from the file, and the file shrinks back
        finally:
            c.close()
    if os.path.exists(history):
        with open(history, "w"):
            pass                          # truncate in place: owner and mode stay as they are
    tmp = since + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"ts": int(now()), "reason": reason}, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, since)
    return removed


def last_reset_day(since=None):
    """Local date the history was last emptied, or None (never / unreadable)."""
    try:
        with open(since or SINCE) as f:
            return datetime.date.fromtimestamp(int(json.load(f)["ts"]))
    except (OSError, ValueError, KeyError, TypeError):
        return None


def forget_visited_wifi(run=subprocess.run):
    """Delete the saved Wi-Fi of visited sites (passwords included) through the app's existing sudo rule."""
    try:
        p = run(["sudo", "-n", "/usr/local/bin/wifi-clear"], capture_output=True, text=True, timeout=60)
        gone = [l.strip()[len("deleted: "):] for l in p.stdout.splitlines() if l.strip().startswith("deleted: ")]
        log("visited Wi-Fi forgotten: %s" % (", ".join(gone) or "none saved"))
        return gone
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"could not forget visited Wi-Fi: {e!r}")
        return None


def check(since=None, now=time.time, forget=None, **kw):
    """Empty the history when the day has changed since the last reset. Returns the removed rows, or None if kept."""
    today, last = datetime.date.fromtimestamp(now()), last_reset_day(since)
    if last is not None and last >= today:
        return None
    removed = wipe("new-day", since=since, now=now, **kw)
    log("new day (last reset %s): history cleared %s" % (last or "never", removed or "(nothing yet)"))
    (forget or forget_visited_wifi)()
    return removed


def main(argv):
    if argv[1:] == ["--check"] or argv[1:] == ["--boot"]:   # --boot: name used by the earlier unit
        try:
            if os.path.exists(OLD_MARKER):
                os.remove(OLD_MARKER)
            check()
        except Exception as e:            # never hold up the boot: the app starts either way
            log(f"could not check/clear the history: {e!r}")
        return 0
    if argv[1:] == ["--shutdown"]:        # the earlier unit's ExecStop: nothing to do any more
        return 0
    if argv[1:] == ["--now"]:
        log("history cleared %s" % (wipe("manual") or "(nothing yet)"))
        return 0
    sys.stderr.write(__doc__)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv))
