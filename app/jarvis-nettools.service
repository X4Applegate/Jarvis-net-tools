[Unit]
Description=Jarvis Net Tools (standalone VPN-only mobile app)
# no wait for network-online / the VPN: the touch screen talks to 127.0.0.1 and should appear seconds after boot;
# app.py adds the NETTOOLS_BIND (VPN) listener by itself as soon as that address exists
After=NetworkManager.service

[Service]
Type=simple
User=nettools
Group=nettools
Environment=NETTOOLS_BIND=127.0.0.1
# ^ the address the app listens on: your VPN address (127.0.0.1 = reachable from this Pi only)
Environment=NETTOOLS_PORT=8092
Environment=HOME=/opt/jarvis-nettools
WorkingDirectory=/opt/jarvis-nettools
ExecStart=/usr/bin/python3 /opt/jarvis-nettools/app.py
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=false
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/var/lib/jarvis-nettools /etc/jarvis-nettools

[Install]
WantedBy=multi-user.target
