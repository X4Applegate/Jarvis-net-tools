[Unit]
Description=Jarvis Pi: setup hotspot only when needed (off while the Pi has a network, on after 2 min without one)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# install-pi.sh writes the hotspot profile name here (--hotspot-ssid)
Environment=HOTSPOT_PROFILE=JarvisPi-Manage
Environment=HOTSPOT_IFACE=wlan0
ExecStart=/usr/local/sbin/jarvis-hotspot-auto
Restart=always
RestartSec=5
RuntimeDirectory=jarvis-hotspot-auto
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
