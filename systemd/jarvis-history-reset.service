[Unit]
Description=Jarvis Net Tools: the history lasts one day (emptied when a new day starts)
# at boot: runs before the app and the monitor write anything; jarvis-history-reset.timer runs it again every 10 minutes
After=local-fs.target
Before=jarvis-nettools.service jarvis-netmon.service

[Service]
Type=oneshot
User=nettools
Group=nettools
ExecStart=/usr/local/bin/jarvis-history-reset --check
# no NoNewPrivileges: on a new day it forgets visited Wi-Fi through sudo (/usr/local/bin/wifi-clear, already in sudoers)
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
